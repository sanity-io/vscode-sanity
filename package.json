{
  "name": "vscode-sanity",
  "displayName": "Sanity.io",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "description": "Developer tools for applications powered by Sanity.io: GROQ query execution, linting, completion and formatting",
  "author": "Sanity.io <hello@sanity.io>",
  "publisher": "sanity-io",
  "engines": {
    "vscode": "^1.107.0"
  },
  "keywords": [
    "vscode",
    "visual studio code",
    "sanity",
    "groq",
    "linter",
    "formatter"
  ],
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sanity-io/vscode-sanity.git"
  },
  "bugs": {
    "url": "https://github.com/sanity-io/vscode-sanity/issues"
  },
  "homepage": "https://github.com/sanity-io/vscode-sanity/blob/main/README.md",
  "icon": "images/icon.png",
  "activationEvents": [
    "onLanguage:groq",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Sanity",
      "properties": {
        "sanity.useCodelens": {
          "type": "boolean",
          "default": true,
          "description": "Enable GROQ codelens."
        },
        "sanity.useCDN": {
          "type": "boolean",
          "default": false,
          "description": "Use APICDN for GROQ queries."
        },
        "sanity.openJSONFile": {
          "type": "boolean",
          "default": false,
          "description": "Open query results in a new tab as an editable JSON file."
        },
        "sanity.formatGroqInHover": {
          "type": "boolean",
          "default": true,
          "description": "Show GROQ queries found in JavaScript and TypeScript hovers (such as types of .groq imports) as formatted, syntax-highlighted code."
        },
        "sanity.formatGroqInHoverWidth": {
          "type": "integer",
          "default": 80,
          "minimum": 20,
          "description": "Column width the GROQ queries shown in hovers are wrapped to."
        },
        "groq.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable the GROQ language server: diagnostics, completion, hover and formatting in `.groq` files and groq`` template literals."
        },
        "groq.schemaPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the schema file from `npx sanity schema extract`, absolute or relative to the first workspace folder. When empty, `schema.json`, `sanity.schema.json`, `.sanity/schema.json` and `studio/schema.json` in the first workspace folder are tried."
        },
        "groq.maxDiagnostics": {
          "type": "integer",
          "default": 100,
          "minimum": 0,
          "description": "Maximum number of GROQ diagnostics reported per file."
        },
        "groq.enableFormatting": {
          "type": "boolean",
          "default": true,
          "description": "Enable GROQ formatting."
        },
        "groq.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the GROQ language server."
        }
      }
    },
    "commands": [
      {
        "command": "sanity.executeGroq",
        "title": "Execute GROQ query"
      },
      {
        "command": "groq.formatQueries",
        "title": "Format GROQ Queries",
        "category": "GROQ"
      },
      {
        "command": "groq.restartServer",
        "title": "Restart Language Server",
        "category": "GROQ"
      },
      {
        "command": "groq.showOutput",
        "title": "Show Language Server Output",
        "category": "GROQ"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sanity.executeGroq",
          "when": "editorLangId == groq || editorLangId == plaintext"
        },
        {
          "command": "groq.formatQueries",
          "when": "editorLangId =~ /^(groq|javascript|javascriptreact|typescript|typescriptreact)$/"
        }
      ]
    },
    "languages": [
      {
        "id": "groq",
        "aliases": [
          "GROQ",
          "groq"
        ],
        "extensions": [
          ".groq"
        ],
        "configuration": "./language/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "groq",
        "scopeName": "source.groq",
        "path": "./dist/textmate/groq.tmLanguage.json"
      },
      {
        "injectTo": [
          "source.js",
          "source.ts",
          "source.js.jsx",
          "source.tsx",
          "source.vue",
          "source.svelte",
          "source.php",
          "source.astro"
        ],
        "scopeName": "groq-injection.js",
        "path": "./dist/textmate/javascript.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.groq": "groq"
        }
      },
      {
        "scopeName": "groq-injection.markdown",
        "path": "./dist/textmate/markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.groq": "groq"
        }
      }
    ],
    "snippets": [
      {
        "language": "groq",
        "path": "./snippets/groq.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/groq-ts.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/groq-ts.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/groq-ts.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/groq-ts.json"
      }
    ],
    "keybindings": [
      {
        "command": "sanity.executeGroq",
        "key": "ctrl+shift+g",
        "mac": "ctrl+shift+g",
        "when": "editorTextFocus"
      }
    ]
  },
  "dependencies": {
    "@sanity-labs/groq-wasm": "^1.2.1",
    "@sanity/client": "^8.16.0",
    "@sanity/textmate-groq": "^1.1.2",
    "groq-js": "^2.0.1",
    "line-number": "^0.1.0",
    "osenv": "^0.1.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-jason": "^1.1.2",
    "sucrase": "^3.35.1",
    "vscode-languageclient": "^11.0.0",
    "xdg-basedir": "^4.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@nkzw/oxlint-config": "^3.0.0",
    "@sanity-labs/groq-content-mapper": "^0.7.0",
    "@sanity-labs/groq-lsp": "^1.0.10",
    "@sanity-labs/lint-core": "^1.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.107.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "mocha": "^12.0.3",
    "ovsx": "^1.4.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "tsdown": "^0.23.7",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "^7.0.2",
    "typescript-7": "npm:typescript@7.1.0-beta",
    "vscode-languageserver": "^11.0.0",
    "vscode-languageserver-protocol": "^3.18.5",
    "vscode-languageserver-textdocument": "^1.0.16",
    "vscode-uri": "^3.2.0"
  },
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && pnpm run compile && node --test \"out/*.test.js\" \"out/hover/*.test.js\" \"out/lsp/*.test.js\"",
    "test:integration": "pnpm run build && pnpm run compile && node out/test/runTest.js",
    "test:integration:tsgo": "pnpm run build && pnpm run compile && node out/test/runTest.js --tsgo",
    "build": "tsdown",
    "compile": "tsc -p ./",
    "watch": "tsdown --watch",
    "vscode:prepublish": "tsdown",
    "env:source": "export $(cat .envrc | xargs)",
    "package": "vsce package --no-dependencies",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "release": "bash scripts/release.sh",
    "upgrade-interactive": "pnpm update --interactive"
  },
  "volta": {
    "node": "26.13.1"
  },
  "packageManager": "pnpm@12.22.0"
}
