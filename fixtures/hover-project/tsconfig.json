{
  "compilerOptions": {"strict": true, "module": "esnext", "moduleResolution": "bundler", "target": "es2022", "noEmit": true, "skipLibCheck": true},
  "include": ["src"],
  "contentMappers": [
    {"package": "@sanity-labs/groq-content-mapper", "extensions": [".groq"],
     "options": {"schema": "./schema.json", "functions": ["groq/*.groq"]}}
  ]
}
